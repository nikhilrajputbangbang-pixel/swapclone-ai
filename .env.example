# Copy this file to .env after creating your AdSense account.
# Keep the publisher ID in the format Google gives you, e.g. ca-pub-1234567890123456
VITE_ADSENSE_CLIENT=ca-pub-REPLACE_WITH_YOUR_PUBLISHER_ID

# Create ad units in AdSense and paste their slot IDs here.
VITE_ADSENSE_SLOT_TOP=REPLACE_WITH_TOP_SLOT_ID
VITE_ADSENSE_SLOT_MID=REPLACE_WITH_MID_SLOT_ID
VITE_ADSENSE_SLOT_BOTTOM=REPLACE_WITH_BOTTOM_SLOT_ID

# Optional Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
VITE_GA_ID=
